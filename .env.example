# --- Inicio rápido (sin MySQL) ---
DB_ENGINE=sqlite
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Para usar MySQL: DB_ENGINE=mysql y completar estos datos (pip install -r requirements-mysql.txt) ---
MYSQL_DATABASE=bemba_pos
MYSQL_USER=bemba_user
MYSQL_PASSWORD=bemba_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Alertas de stock (correo)
ALERT_EMAIL_RECIPIENTS=admin@example.com

# Mesas y carta por QR
# Dirección con la que los celulares abren la carta (IP de tu red o dominio). Sin barra final.
PUBLIC_BASE_URL=
TABLE_PENDING_MINUTES=10
TABLE_CLEANING_MINUTES=5
# Minutos que espera un pedido del cliente antes de vencer si nadie lo confirma
CUSTOMER_ORDER_EXPIRY_MINUTES=15
